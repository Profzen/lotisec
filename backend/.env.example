PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/lotisec
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SUPABASE_JWT_SECRET=replace-with-the-supabase-project-jwt-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ENABLE_LEGACY_PRO_LOGIN=false
ENABLE_LEGACY_SCAN_CODES=false
DEEPINFRA_API_KEY=replace-with-a-new-deepinfra-api-key
AI_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_TRANSCRIPTION_MODEL=openai/whisper-large
AI_TTS_MODEL=hexgrad/Kokoro-82M
AI_RAG_THRESHOLD=0.45
AI_RAG_TOP_K=3
