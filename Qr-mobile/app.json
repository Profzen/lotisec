{
  "expo": {
    "name": "LOTISEC",
    "slug": "lotisec",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo-118.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/logo-118.png",
      "resizeMode": "contain",
      "backgroundColor": "#006A4E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lotisec.togo",
      "splash": {
        "image": "./assets/logo-118.png",
        "resizeMode": "contain",
        "backgroundColor": "#006A4E"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-118.png",
        "backgroundColor": "#006A4E"
      },
      "package": "com.lotisec.togo",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSy_FAKE_KEY_FOR_OPENSTREETMAP_BYPASS"
        }
      },
      "splash": {
        "image": "./assets/logo-118.png",
        "resizeMode": "contain",
        "backgroundColor": "#006A4E"
      }
    },
    "web": {
      "favicon": "./assets/logo-118.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#006A4E",
          "image": "./assets/logo-118.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aca73ec4-a52e-4350-83cc-0804d7730ac5"
      }
    },
    "owner": "profzen"
  }
}
