{
  "expo": {
    "name": "SafeLife",
    "slug": "safelife",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/Safe_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/SafeLife.png",
      "resizeMode": "contain",
      "backgroundColor": "#006a4e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.safelife.togo",
      "splash": {
        "image": "./assets/SafeLife.png",
        "resizeMode": "contain",
        "backgroundColor": "#006a4e"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/SafeLife.png",
        "backgroundColor": "#006a4e"
      },
      "package": "com.safelife.togo",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSy_FAKE_KEY_FOR_OPENSTREETMAP_BYPASS"
        }
      },
      "splash": {
        "image": "./assets/SafeLife.png",
        "resizeMode": "contain",
        "backgroundColor": "#006a4e"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#006a4e",
          "image": "./assets/SafeLife.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3f8d2fc4-3470-46c4-9ad7-02a45d9b2414"
      }
    }
  }
}
