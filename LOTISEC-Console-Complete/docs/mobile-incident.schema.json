{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lotisec.tg/schemas/mobile-incident-1.0.json",
  "title": "Signalement mobile LOTISEC",
  "type": "object",
  "required": ["id", "type", "severity", "latitude", "longitude", "accuracy", "victims", "timestamp", "schemaVersion", "correlationId"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "externalId": { "type": "string", "maxLength": 80 },
    "type": { "type": "string", "minLength": 1, "maxLength": 120 },
    "severity": { "enum": ["Faible", "Modérée", "Élevée", "Critique", "À évaluer", "unknown", "critical", "high", "medium", "low"] },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "accuracy": { "type": "number", "minimum": 0, "maximum": 10000 },
    "address": { "type": "string", "maxLength": 300 },
    "victims": { "type": "integer", "minimum": 0, "maximum": 100 },
    "vehicles": { "type": "integer", "minimum": 0, "maximum": 100 },
    "vehicle_type": { "type": "string", "maxLength": 100 },
    "description": { "type": "string", "maxLength": 2000 },
    "requested_service": { "enum": ["fire", "ambulance", "samu", "police"] },
    "flags": { "type": "array", "items": { "type": "string" } },
    "client_event_id": { "type": "string", "maxLength": 120 },
    "timestamp": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "string" },
    "correlationId": { "type": "string", "maxLength": 80 },
    "deviceId": { "type": "string", "maxLength": 120 },
    "reporterReference": { "type": "string", "maxLength": 120 },
    "mediaCount": { "type": "integer", "minimum": 0, "maximum": 20 }
  },
  "additionalProperties": true
}
